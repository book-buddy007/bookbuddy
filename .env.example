# ============================================================================
# Book Buddy by VPD — frontend (Next.js) environment
#
# scripts/clean-slate.ps1 copies this file to .env.local and fills every
# placeholder (the double-underscore names) with a freshly generated value. Blank = optional, feature off.
# ============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
BACKEND_INTERNAL_URL=http://localhost:3333

# ── Database (same database as the backend) ─────────────────────────────────
DATABASE_URL=postgresql://bookbuddy:__POSTGRES_PASSWORD__@127.0.0.1:5440/book_buddy

# ── Auth (secrets must match backend/.env) ──────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
JWT_SECRET=__JWT_SECRET__
NEXT_PUBLIC_DRM_KEY=__DRM_KEY__

# ── File storage (local MinIO from docker-compose.yml) ──────────────────────
S3_ENDPOINT=http://localhost:9000
CDN_BASE_URL=http://localhost:9000/book-buddy-media
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/book-buddy-media
MEDIA_PROXY_ALLOWED_HOSTS=localhost

# ── Google sign-in (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Authorised redirect URI in Google Cloud Console: ${BETTER_AUTH_URL}/api/auth/callback/google
# Google always signs in people who already have an account (matched by verified email). It creates
# NEW accounts only when GOOGLE_SIGNUP_ENABLED=true (Google only) or PUBLIC_SIGNUP_ENABLED=true
# (broader; also opens the backend POST /auth/register). Both default to false here.
# GOOGLE_SIGNUP_ENABLED=false
# PUBLIC_SIGNUP_ENABLED=false
# SUPER_ADMIN_EMAIL=you@gmail.com   # the ONLY address ever made super-admin, and only after Google verifies it

# ── Error monitoring (optional) ─────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ── External integrations — OFF. Leave as-is for a standalone app ───────────
FEDERATION_ENABLED=false
NEXT_PUBLIC_FEDERATION_ENABLED=false
# VIDYAVERSE_ISSUER=
# VIDYAVERSE_CLIENT_ID=
# VIDYAVERSE_CLIENT_SECRET=
# ENTITLEMENTS_WEBHOOK_SECRET=
# FEDERATION_SUPER_ADMIN_SUBS=

# ============================================================================
# Book Buddy by VPD — backend (NestJS) environment
#
# scripts/clean-slate.ps1 copies this file to backend/.env and fills every
# placeholder (the double-underscore names) with a freshly generated value. Anything left blank is an
# optional third-party service: the matching feature stays off until you add a key.
# ============================================================================

NODE_ENV=development
PORT=3333
APP_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# ── Database (local Postgres from docker-compose.yml) ───────────────────────
DATABASE_URL=postgresql://bookbuddy:__POSTGRES_PASSWORD__@127.0.0.1:5440/book_buddy

# ── Auth secrets (must match the values in .env.local) ──────────────────────
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_HMAC_SECRET=__OTP_HMAC_SECRET__
# Must equal NEXT_PUBLIC_DRM_KEY in .env.local (backend encrypts, browser decrypts)
DRM_SECRET_KEY=__DRM_KEY__
# The only address allowed to hold the super-admin role
SUPER_ADMIN_EMAIL=__SUPER_ADMIN_EMAIL__

# ── Redis / BullMQ queues (docker-compose.yml) ──────────────────────────────
REDIS_URL=redis://127.0.0.1:6381
REDIS_HOST=127.0.0.1
REDIS_PORT=6381

# ── File storage — local MinIO (docker-compose.yml) ─────────────────────────
# Production uses Cloudflare R2; see docs/storage-r2.md. The R2 equivalent of this block is:
#   STORAGE_PROVIDER=r2
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<R2 token, Object Read & Write on the bucket>
#   S3_SECRET_ACCESS_KEY=<R2 token secret>
#   S3_BUCKET_NAME=bookbuddy                 # PRIVATE bucket: book files, audio, personal uploads
#   S3_PUBLIC_BUCKET_NAME=bookbuddymedia   # PUBLIC bucket: covers, samples, branding (leave unset locally: one bucket)
#   CDN_BASE_URL=https://media.bookbuddy.live   # custom domain of the PUBLIC bucket only, no bucket in the path
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=bookbuddy
S3_SECRET_ACCESS_KEY=__MINIO_PASSWORD__
S3_BUCKET_NAME=book-buddy-media
CDN_BASE_URL=http://localhost:9000/book-buddy-media

# ── Vector search — local Qdrant (docker-compose.yml) ───────────────────────
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION_NAME=book_buddy_books_v1
QDRANT_ALLOW_COLLECTION_CREATE=true
EMBEDDING_DIMENSIONS=768

# ── AI (optional — AI study features stay off until a provider key is set) ──
LLM_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
CF_EMBED_MODEL=@cf/google/embeddinggemma-300m
CF_CHAT_MODEL=@cf/google/gemma-4-26b-a4b-it
# OPENAI_API_KEY=
ENABLE_HYBRID_SEARCH=false
ENABLE_RERANKING=true
ENABLE_QUERY_DECOMPOSITION=false
ENABLE_CHAPTER_VALIDATION=true
DOC_EXTRACT_ENGINE_PYTHON_PATH=python
DAILY_AI_QUERY_LIMIT=100
VARTA_SOFT_LIMIT_TOKENS=40000
VARTA_HARD_LIMIT_TOKENS=60000
VARTA_MAX_QUERY_TOKENS=4000
AI_CHAT_RETENTION_DAYS=365

# ── Email (optional — Resend). Blank = emails are logged, not sent ──────────
# RESEND_API_KEY=
EMAIL_FROM=Book Buddy <noreply@example.com>

# ── Public sign-up (default OFF) ─────────────────────────────────────────────
# POST /auth/register and first-time Google sign-in create accounts only when this is exactly
# "true". Even then they can only create a trial student; staff accounts come from an administrator.
# PUBLIC_SIGNUP_ENABLED=false
# GOOGLE_SIGNUP_ENABLED=false   # opens first-time Google sign-in only; POST /auth/register stays closed

# ── Google sign-in for the mobile app (optional) ────────────────────────────
# GOOGLE_OAUTH_CLIENT_IDS=

# ── WhatsApp OTP (optional) ─────────────────────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_OTP_TEMPLATE_NAME=book_buddy_otp
WHATSAPP_API_VERSION=v25.0

# ── Error monitoring (optional) ─────────────────────────────────────────────
# SENTRY_DSN=

# ── External integrations — OFF. Leave blank for a standalone app ───────────
# VIDYAVERSE_ISSUER=
# TAXONOMY_SERVICE_URL=
# TAXONOMY_SERVICE_API_KEY=
# TRIO_CONTENT_DATABASE_URL=
# TRIO_SANCHIKA_DATABASE_URL=
# TRIO_INGEST_URL=
# TRIO_PURGE_URL=
# TRIO_SERVICE_SECRET=

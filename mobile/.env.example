# Base URL of the shared Book Buddy NestJS backend (same API + database as the web app).
# Any var prefixed EXPO_PUBLIC_ is inlined into the app at build time.
#
#  - iOS simulator:      http://localhost:3333
#  - Android emulator:   http://10.0.2.2:3333   (localhost won't reach the host)
#  - Physical device:    http://<your-LAN-IP>:3333  e.g. http://192.168.1.20:3333
#  - Production:         https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# Must equal DRM_SECRET_KEY in backend/.env (decrypts protected read links).
EXPO_PUBLIC_DRM_KEY=

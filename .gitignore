# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies (all workspaces: root, backend, mobile, frontend, …)
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Build / generated output
# ---------------------------------------------------------------------------
.next/
out/
build/
dist/
backend/dist/
web-build/

# Expo (mobile)
.expo/
mobile/.expo/
expo-env.d.ts

# Prisma generated client
**/.prisma/
**/generated/prisma/

# ---------------------------------------------------------------------------
# Environment / secrets  (NEVER commit real credentials)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.docker

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# TypeScript / tooling caches
# ---------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts
.eslintcache

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
coverage/
cypress/videos/
cypress/screenshots/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.orig.*

# ---------------------------------------------------------------------------
# Local database dumps / scratch (large, environment-specific)
# ---------------------------------------------------------------------------
backup_book_buddy*.sql
*.vhdx
*.apk
docker_backup/


# --- Security hardening (added 2026-07-30): never commit secrets/dumps ---
*.env.bak*
.env.bak*
*-dump.md
*.dump
db-dump*
TEST_ACCOUNTS.md
update-password*.ts

# secret-bearing artifacts (gitleaks 2026-08)
*.dump
*.bak
*.bak-*
.env.bak*
*-dump.md
.backups/
backend/set-cors.js
backend/scratch*.js

# --- Claude Code (2026-08-11) -----------------------------------------------
# Track the SHARED agent config so a fresh clone gets it:
#   .claude/settings.json, .claude/hooks/, .claude/skills/, .claude/launch.json
# Ignore the per-machine and per-session parts. `.claude/worktrees/` is the
# important one: each worktree is a FULL second checkout of the app, and until
# now it sat untracked inside both the repo and the Docker build context.
.claude/worktrees/
.claude/settings.local.json
.claude/session-*.log

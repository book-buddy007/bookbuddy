{
  "name": "book-buddy-vpd",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:landing": "next dev",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "next dev",
    "build": "node scripts/clean-next.js && next build",
    "start": "next start",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "next build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:migrate:deploy": "cd backend && npx prisma migrate deploy",
    "db:generate": "cd backend && npx prisma generate",
    "db:studio": "cd backend && npx prisma studio",
    "db:seed": "cd backend && npx prisma db seed",
    "db:check-schema-sync": "node scripts/check-schema-sync.js",
    "test": "cd backend && npm test",
    "test:e2e": "cd backend && npm run test:e2e",
    "install:all": "npm install && cd backend && npm install --legacy-peer-deps && cd ../mobile && npm install",
    "postinstall": "prisma generate",
    "lint": "eslint ."
  },
